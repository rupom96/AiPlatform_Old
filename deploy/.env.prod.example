# সার্ভারে এটা `.env` নামে কপি করো, মান বসাও। ⚠️ .env কখনো git-এ যাবে না।

# GHCR path — lowercase বাধ্যতামূলক
REGISTRY=ghcr.io/saifulpavel
TAG=latest

# ব্রাউজারে যে hostname দিয়ে ঢুকবে (scheme ছাড়া)। Caddy এই নামেই TLS cert নেয়।
PUBLIC_HOST=app.yourdomain.com

# --- secret: নতুন করে বানাও, dev-এর মান কখনো নয় -----------------------------
# ⚠️ appsettings.Development.json-এর JWT key ও SQL password public GitHub repo-তে
# ছিল — ওগুলো আর গোপন নয়, production-এ ব্যবহার করলে যে কেউ token বানাতে পারবে।
#
# JWT_SECRET বানাও (PowerShell):
#   $b=New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Fill($b); [Convert]::ToHexString($b)
SA_PASSWORD=
JWT_SECRET=

# --- LLM key ------------------------------------------------------------------
GEMINI_API_KEY=
GROQ_API_KEY=

# --- ঐচ্ছিক -------------------------------------------------------------------
GOOGLE_CLIENT_ID=
