{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Otel": {
    "Enabled": true,
    "ServiceName": "AiPlatform.Api"
  },
  "Jwt": {
    "Issuer": "AiPlatform",
    "Audience": "AiPlatform.Client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Frontend": {
    "BaseUrl": "http://localhost:5173"
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "User": "",
    "FromEmail": "",
    "FromName": "AiPlatform"
  },
  "Authentication": {
    "Google": {
      "ClientId": ""
    }
  },
  "Erp": {
    // Development-এ true (appsettings.Development.json) — startup-এ ERP DB migrate + sample data seed।
    "SeedOnStartup": false
  },
  "Llm": {
    "DefaultProvider": "gemini",
    "Providers": {
      "gemini":     { "Type": "gemini", "Model": "gemini-2.5-flash-lite" },
      // 2026-10-29 যাচাই: llama-3.3-70b-versatile Groq থেকে উঠে গেছে (404 "model does not exist")।
      // account-এ এখন আছে gpt-oss-120b / gpt-oss-20b / qwen3.8-27b; gpt-oss-120b tool-calling নেয়।
      "groq":       { "Type": "openai", "BaseUrl": "https://api.groq.com/openai/v1/chat/completions", "Model": "openai/gpt-oss-120b" },
      // 2026-07-22 যাচাই: llama আর নেই Cerebras-এ; আসল model = gpt-oss-120b / zai-glm-4.7 / gemma-4-31b।
      // gpt-oss-120b: tool-calling নিখুঁত, ~0.7s (groq-এর চেয়েও দ্রুত)।
      "cerebras":   { "Type": "openai", "BaseUrl": "https://api.cerebras.ai/v1/chat/completions", "Model": "gpt-oss-120b" },
      // 2026-10-29: llama-3.3-70b-instruct-এর :free slug তুলে নেওয়া হয়েছে (paid-ই কেবল আছে)।
      // free + tool-calling দুটোই মেলে এমন model থেকে বাছা; gemma-4-31b:free ঐ সময় 429 দিচ্ছিল।
      "openrouter": { "Type": "openai", "BaseUrl": "https://openrouter.ai/api/v1/chat/completions", "Model": "nvidia/nemotron-3.5-lightning:free" },
      "mistral":    { "Type": "openai", "BaseUrl": "https://api.mistral.ai/v1/chat/completions", "Model": "mistral-small-latest" },
      "github":     { "Type": "openai", "BaseUrl": "https://models.github.ai/inference/chat/completions", "Model": "openai/gpt-4o-mini" },
      "ollama":     { "Type": "openai", "BaseUrl": "http://localhost:11434/v1/chat/completions", "Model": "llama3.1:8b", "RequiresApiKey": false },
      // GPU সার্ভারের ollama — UI-র Local/Server toggle এই দুটোর মাঝে বদলায়।
      // ⚠️ port 8901, PDF-এর 8601 নয় — 8601 বাইরে থেকে বন্ধ, আর 8901-ই আসল Ollama API
      // (/api/version → 0.40.11)। host/port বদলালে এখানে নয়, env var-এ:
      // Llm__Providers__ollama-server__BaseUrl
      "ollama-server": { "Type": "openai", "BaseUrl": "http://118.67.212.44:8901/v1/chat/completions", "Model": "qwen2.5:7b", "RequiresApiKey": false }
    },
    "Embedding": { "Provider": "gemini", "Model": "gemini-embedding-001" },
    "_Embedding_ollama_example": { "Provider": "ollama", "Model": "nomic-embed-text", "BaseUrl": "http://localhost:11434" },
    // এক provider ব্যর্থ (quota/hiccup/timeout) হলে পরেরটায় — request মরে না।
    // ক্রম: দ্রুততম আগে, local সবার শেষে (কখনো quota শেষ হয় না, তবে CPU-তে ধীর)।
    // explicit provider চাইলে chain bypass হয় — "ollama দিয়ে চালাও" মানে সত্যিই ollama।
    "Fallback": {
      "Enabled": true,
      "Chain": [ "cerebras", "groq", "gemini", "ollama" ]
    },
    "Routing": {
      "Enabled": true,
      "CheapProvider": "ollama",
      "StrongProvider": "cerebras",
      "WordThreshold": 30,
      "BanglaWordThreshold": 12,
      "ComplexKeywords": [ "explain", "analyze", "compare", "why", "step by step", "reasoning", "prove", "design", "architecture", "ব্যাখ্যা", "বিশ্লেষণ", "তুলনা", "কেন" ]
    },
    "Pricing": {
      "gemini-2.5-flash-lite":    { "InputPerMillion": 0.10, "OutputPerMillion": 0.40 },
      "openai/gpt-oss-120b":      { "InputPerMillion": 0.15, "OutputPerMillion": 0.75 },
      "mistral-small-latest":     { "InputPerMillion": 0.20, "OutputPerMillion": 0.60 }
    }
  },
  "SemanticCache": {
    "Enabled": true,
    "SimilarityThreshold": 0.95,
    "Collection": "semantic_cache"
  },
  "Qdrant": {
    "Url": "http://localhost:6333",
    "Collection": "aiplatform_rag"
  },
  "Idempotency": {
    "Enabled": true,
    "TtlHours": 24
  },
  "Agent": {
    "Enabled": true,
    "MaxIterations": 5,
    "ToolRetrievalEnabled": true,
    "ToolTopK": 8,
    "ToolsCollection": "aiplatform_tools"
  },
  "IngestionQueue": {
    "StreamKey": "ingestion:stream",
    "GroupName": "ingestion-workers",
    "MinIdleMs": 60000,
    "PollDelayMs": 1000
  },
  "Conversation": {
    "Enabled": true,
    "MaxRecentMessages": 10,
    "TtlHours": 24
  },
  "Guardrails": {
    "Enabled": true,
    "RedactPii": true,
    "InjectionPatterns": [
      "ignore\\s+(all\\s+)?(previous|prior|above)\\s+(instructions?|prompts?|rules?)",
      "disregard\\s+(all\\s+)?(previous|prior|above)",
      "reveal\\s+(your|the)\\s+(system\\s+)?(prompt|instructions?)",
      "you\\s+are\\s+now\\s+",
      "pretend\\s+to\\s+be",
      "আগের\\s+(সব\\s+)?নির্দেশ.*(উপেক্ষা|ভুলে)",
      "সিস্টেম\\s+প্রম্পট"
    ]
  },
  "AllowedHosts": "*"
}
